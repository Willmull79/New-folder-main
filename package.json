{
  "name": "fantasy-dynasty-central",
  "version": "1.0.0",
  "description": "Fantasy Dynasty Central - A comprehensive fantasy football management platform",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:analyze": "webpack --mode production --analyze",
    "dev": "webpack serve --mode development --open",
    "serve": "http-server dist -p 8080",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build:css:prod": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "clean": "rmdir /s /q dist 2>nul || echo dist folder cleaned",
    "prebuild": "npm run clean",
    "init-nfl-data": "node scripts/init-nfl-data.js"
  },
  "dependencies": {
    "firebase": "^9.22.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@tailwindcss/postcss": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.3.0",
    "tailwindcss": "^4.1.11",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "keywords": [
    "fantasy",
    "football",
    "dynasty",
    "react",
    "firebase"
  ],
  "author": "Fantasy Dynasty Central",
  "license": "MIT"
}
