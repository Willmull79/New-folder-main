rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model (Dynasty Leagues)
    // ===============================================================
    //
    // leagues/{leagueId}
    //   commissionerId: string
    //   coCommissioners: string[]
    //   memberIds: string[]          // all owners + commissioners (required for authz)
    //   members: string[]            // optional legacy
    //   teams: string[]              // team doc ids
    //   settings, draft, auction, allRosteredPlayerIds, dues, ...
    //
    // leagues/{leagueId}/teams/{teamId}
    //   ownerId, teamName, roster, wins/losses/ties, liveScore, standings, ...
    //
    // leagues/{leagueId}/messages|trades|waivers|notifications/...
    //
    // artifacts/{appId}/users/{userId}/userProfile/settings
    //   username, avatarUrl, email, phoneNumber, subscription (Admin/webhook only)
    //
    // players|teams|games|scores|stats|data_updates — NFL reference data (Admin write)
    //
    // direct_messages/{chatId}/messages/{messageId}
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    function isPrimaryCommissioner(leagueId) {
      return isSignedIn() && leagueDoc(leagueId).commissionerId == request.auth.uid;
    }

    function isCommissioner(leagueId) {
      return isSignedIn() && (
        leagueDoc(leagueId).commissionerId == request.auth.uid ||
        request.auth.uid in leagueDoc(leagueId).get('coCommissioners', [])
      );
    }

    function isLeagueMember(leagueId) {
      return isSignedIn() && (
        isCommissioner(leagueId) ||
        request.auth.uid in leagueDoc(leagueId).get('memberIds', []) ||
        request.auth.uid in leagueDoc(leagueId).get('members', [])
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function teamProtectedKeys() {
      return [
        'wins', 'losses', 'ties',
        'pointsFor', 'pointsAgainst',
        'standings', 'finalizedScore',
        'ownerId'
      ].toSet();
    }

    function leagueGameplayKeys() {
      return ['draft', 'auction', 'allRosteredPlayerIds', 'teams', 'updatedAt'].toSet();
    }

    function leagueJoinKeys() {
      return ['teams', 'memberIds', 'members'].toSet();
    }

    function isSelfJoin() {
      // Join-by-ID: add self to memberIds in the same write that registers the new team id
      return isSignedIn()
        && changedKeys().hasOnly(leagueJoinKeys())
        && request.auth.uid in request.resource.data.get('memberIds', [])
        && !(request.auth.uid in resource.data.get('memberIds', []))
        && request.resource.data.get('teams', []).size()
          == resource.data.get('teams', []).size() + 1;
    }

    function profileClientKeys() {
      return ['username', 'avatarUrl', 'email', 'phoneNumber', 'updatedAt', 'createdAt'].toSet();
    }

    // ---------- User profiles (subscription is Admin/webhook only) ----------
    match /artifacts/{appId}/users/{userId}/userProfile/{docId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && !('subscription' in request.resource.data)
        && request.resource.data.keys().hasOnly(profileClientKeys());
      allow update: if isUser(userId)
        && !changedKeys().hasAny(['subscription'])
        && changedKeys().hasOnly(profileClientKeys());
      allow delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    // ---------- NFL / platform reference data (client read-only) ----------
    match /players/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /teams/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /games/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /scores/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /stats/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /data_updates/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- Leagues ----------
    match /leagues/{leagueId} {
      // Join-by-ID needs get before membership exists
      allow get: if isSignedIn();
      // Clients query: where('memberIds', 'array-contains', uid)
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.get('memberIds', []);

      allow create: if isSignedIn()
        && request.resource.data.commissionerId == request.auth.uid
        && request.auth.uid in request.resource.data.get('memberIds', []);

      allow update: if isSignedIn() && (
        isCommissioner(leagueId)
        || (isLeagueMember(leagueId) && changedKeys().hasOnly(leagueGameplayKeys()))
        || isSelfJoin()
      );

      allow delete: if isPrimaryCommissioner(leagueId);

      match /teams/{teamId} {
        allow get: if isSignedIn() && (
          isLeagueMember(leagueId) || resource.data.ownerId == request.auth.uid
        );
        allow list: if isLeagueMember(leagueId);

        allow create: if isSignedIn()
          && request.resource.data.ownerId == request.auth.uid
          && (
            isLeagueMember(leagueId)
            || leagueDoc(leagueId).get('teams', []).size()
              < leagueDoc(leagueId).get('settings', {}).get('numTeams', 32)
          );

        allow update: if isSignedIn() && (
          isCommissioner(leagueId)
          || (
            isLeagueMember(leagueId)
            && !changedKeys().hasAny(teamProtectedKeys())
          )
        );

        allow delete: if isCommissioner(leagueId)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isLeagueMember(leagueId)
          && request.resource.data.keys().hasAll(['text', 'senderId', 'senderName', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /trades/{tradeId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isLeagueMember(leagueId);
        allow update: if isLeagueMember(leagueId) || isCommissioner(leagueId);
        allow delete: if isCommissioner(leagueId);
      }

      match /waivers/{waiverId} {
        allow read: if isLeagueMember(leagueId);
        allow create, update: if isLeagueMember(leagueId);
        allow delete: if isCommissioner(leagueId);
      }

      match /notifications/{notificationId} {
        allow get: if isSignedIn()
          && resource.data.recipientUserId == request.auth.uid;
        allow list: if isSignedIn()
          && resource.data.recipientUserId == request.auth.uid;
        allow create: if isLeagueMember(leagueId)
          && request.resource.data.recipientUserId is string;
        allow update: if isSignedIn()
          && resource.data.recipientUserId == request.auth.uid
          && changedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }

    // ---------- Direct messages ----------
    match /direct_messages/{chatId} {
      allow read: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/direct_messages/$(chatId))
          || request.auth.uid in resource.data.participants
        );
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // Default deny — no catch-all open access
  }
}
